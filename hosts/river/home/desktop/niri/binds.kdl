// Overrides on top of niri's default binds (Mod+Shift+ß shows them all).
binds {
    // the default Mod+Shift+Slash isn't reachable on a German layout
    Mod+Shift+Ssharp { show-hotkey-overlay; }

    // apps
    Mod+T hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Mod+Return { spawn "kitty"; }

    // dux shell (replaces fuzzel, swaylock, wpctl/playerctl/brightnessctl)
    Mod+Space hotkey-overlay-title="Launcher" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Alt+Space hotkey-overlay-title="Spotlight bar" { spawn "dms" "ipc" "call" "spotlight-bar" "toggle"; }
    Mod+D hotkey-overlay-title="Dash" { spawn "dms" "ipc" "call" "dash" "toggle" ""; }
    Mod+Y hotkey-overlay-title="Wallpapers" { spawn "dms" "ipc" "call" "dash" "toggle" "wallpaper"; }
    Mod+A hotkey-overlay-title="Control center" { spawn "dms" "ipc" "call" "control-center" "toggle"; }
    Mod+Alt+V hotkey-overlay-title="Clipboard" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+N hotkey-overlay-title="Notepad" { spawn "dms" "ipc" "call" "notepad" "toggle"; }
    Mod+Ctrl+N hotkey-overlay-title="Notifications" { spawn "dms" "ipc" "call" "notifications" "toggle"; }
    Mod+X hotkey-overlay-title="Power menu" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+Shift+Comma hotkey-overlay-title="Dux settings" { spawn "dms" "ipc" "call" "settings" "focusOrToggle"; }
    Mod+Shift+C hotkey-overlay-title="Color picker" { spawn "dms" "ipc" "call" "color-picker" "toggle"; }
    Mod+Alt+N hotkey-overlay-title="Night mode" { spawn "dms" "ipc" "call" "night" "toggle"; }
    Mod+Alt+I hotkey-overlay-title="Idle inhibit" { spawn "dms" "ipc" "call" "inhibit" "toggle"; }
    Super+Alt+L hotkey-overlay-title="Lock" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Ctrl+Alt+Delete hotkey-overlay-title="Task manager" { spawn "dms" "ipc" "call" "processlist" "focusOrToggle"; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "3"; }
    XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86AudioMicMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "micmute"; }
    XF86AudioPlay allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioPause allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "playPause"; }
    XF86AudioStop allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "stop"; }
    XF86AudioPrev allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "previous"; }
    XF86AudioNext allow-when-locked=true { spawn "dms" "ipc" "call" "mpris" "next"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "increment" "5" ""; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "dms" "ipc" "call" "brightness" "decrement" "5" ""; }

    Print hotkey-overlay-title="Screenshot: region" { spawn "dms" "screenshot"; }
    Ctrl+Print hotkey-overlay-title="Screenshot: screen" { spawn "dms" "screenshot" "full"; }
    Alt+Print hotkey-overlay-title="Screenshot: window" { spawn "dms" "screenshot" "window"; }

    Mod+Ctrl+1 { move-window-to-workspace 1; }
    Mod+Ctrl+2 { move-window-to-workspace 2; }
    Mod+Ctrl+3 { move-window-to-workspace 3; }
    Mod+Ctrl+4 { move-window-to-workspace 4; }
    Mod+Ctrl+5 { move-window-to-workspace 5; }
    Mod+Ctrl+6 { move-window-to-workspace 6; }
    Mod+Ctrl+7 { move-window-to-workspace 7; }
    Mod+Ctrl+8 { move-window-to-workspace 8; }
    Mod+Ctrl+9 { move-window-to-workspace 9; }
    Mod+Ctrl+Shift+1 { move-column-to-workspace 1; }
    Mod+Ctrl+Shift+2 { move-column-to-workspace 2; }
    Mod+Ctrl+Shift+3 { move-column-to-workspace 3; }
    Mod+Ctrl+Shift+4 { move-column-to-workspace 4; }
    Mod+Ctrl+Shift+5 { move-column-to-workspace 5; }
    Mod+Ctrl+Shift+6 { move-column-to-workspace 6; }
    Mod+Ctrl+Shift+7 { move-column-to-workspace 7; }
    Mod+Ctrl+Shift+8 { move-column-to-workspace 8; }
    Mod+Ctrl+Shift+9 { move-column-to-workspace 9; }
    Mod+Ctrl+Page_Down { move-window-to-workspace-down; }
    Mod+Ctrl+Page_Up   { move-window-to-workspace-up; }
    Mod+Ctrl+U         { move-window-to-workspace-down; }
    Mod+Ctrl+I         { move-window-to-workspace-up; }

    // Switch a window between stacked in its column and its own column beside
    // it. (The default Mod+BracketLeft/Right need AltGr on a German layout.)
    Mod+Udiaeresis       { consume-or-expel-window-left; }
    Mod+Shift+Udiaeresis { consume-or-expel-window-right; }

    // the default Mod+Equal is Shift+0 on a German layout
    Mod+Plus       { set-column-width "+10%"; }
    Mod+Shift+Plus { set-window-height "+10%"; }
}
