window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// noctalia settings window
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id="^gnome-calculator$"
    match app-id="^galculator$"
    match app-id="^blueman-manager$"
    match app-id="^xdg-desktop-portal"
    match app-id="^zoom$"
    match app-id="^zen" title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="^steam$" title="^notificationtoasts"
    open-focused false
    open-floating true
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// blurred noctalia wallpaper inside the overview backdrop
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
