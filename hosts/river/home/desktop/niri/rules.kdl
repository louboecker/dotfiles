window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

window-rule {
    match app-id=r#"^org\.gnome\.Calculator$"#
    match app-id="^gnome-calculator$"
    match app-id="^galculator$"
    match app-id="^blueman-manager$"
    match app-id="^xdg-desktop-portal"
    match app-id="^zoom$"
    match app-id="^zen" title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match app-id="^steam$" title="^notificationtoasts"
    open-focused false
    open-floating true
    default-floating-position x=10 y=10 relative-to="bottom-right"
}

// dux shell's wallpaper stays visible in the overview
layer-rule {
    match namespace="^quickshell$"
    place-within-backdrop true
}
