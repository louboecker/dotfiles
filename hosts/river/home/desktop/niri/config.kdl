include "default-config.kdl"

include "input.kdl"
include "outputs.kdl"
include "layout.kdl"
include "rules.kdl"
include "binds.kdl"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

cursor {
    xcursor-theme "catppuccin-frappe-blue-cursors"
    xcursor-size 24
}

debug {
    // lets noctalia activate windows from notification actions
    honor-xdg-activation-with-invalid-serial
}
